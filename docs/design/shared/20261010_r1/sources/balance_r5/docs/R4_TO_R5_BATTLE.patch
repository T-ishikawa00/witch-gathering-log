+class BattleR5(Battle):
+    """Urgent support is opt-in for ablation; no player AI settings."""
+    def heal_target(self,a):
+        if not self.profile.urgent_support:
+            return super().heal_target(a)
+        choices=[]
+        for aid,t in self.actors.items():
+            if t.hp<=0:continue
+            hp=min(t.stats['hp'],t.hp+self.reserved(aid,'heal',self.now+300))
+            d,loss,projected=self.danger_for(aid)
+            if hp<t.stats['hp'] and (hp*10000<=t.stats['hp']*7000 or (d and projected*10000<=t.stats['hp']*3500)):
+                imminents=[h[0] for h in self.public_forecast() if h[1]==aid]
+                # Known lethal prediction first; tie-breaker keeps canonical ORDER.
+                urgency=0 if d and projected<=0 and imminents and self.now+300<min(imminents) else 1
+                choices.append((urgency,Fraction(hp,t.stats['hp']),ORDER.index(aid),aid))
+        return min(choices)[3] if choices else None
+
+    def choose(self,a):
+        if not self.profile.urgent_support or a.id!='C_APPRENTICE':
+            return super().choose(a)
+        # Compare feasible life-saving support against public impacts, without
+        # granting instant casts, resetting cooldowns, or seeing future RNG.
+        choices=[]
+        for aid,t in self.actors.items():
+            if t.hp<=0:continue
+            danger,loss,proj=self.danger_for(aid)
+            hit_times=[x[0] for x in self.public_forecast() if x[1]==aid]
+            if not danger or proj>0 or not hit_times:continue
+            first=min(hit_times)
+            for skill,kind,windup in [('SK_A_HEAL','heal',300),('SK_A_WARD','ward',250)]:
+                if kind in self.disabled or a.ready.get(skill,0)>self.now or self.now+windup>=first:continue
+                if kind=='heal':gain=min(t.stats['hp']-t.hp,self.heal_nominal(a))
+                else:
+                    amount=self.ward_nominal(a)*(10000+t.stats.get('barrier_received_bp',0))//10000
+                    gain=self.rules.barrier_add(self.shield_total(t),t.stats['hp'],amount)
+                if gain>0:
+                    can_save=proj+gain>0
+                    choices.append((0 if can_save else 1,first,-Fraction(proj+gain,t.stats['hp']),windup,ORDER.index(aid),skill,aid))
+        if choices:
+            best=min(choices)
+            return best[-2],best[-1]
+        # General rule: effective healing first, then ward; no emergency paired
+        # action was available. Keep buffs/reactions identical to R4.
+        heal=self.heal_target(a) if 'heal' not in self.disabled else None
+        ward=self.ward_target(a) if 'ward' not in self.disabled else None
+        if heal and a.ready.get('SK_A_HEAL',0)<=self.now:return 'SK_A_HEAL',heal
+        if ward and a.ready.get('SK_A_WARD',0)<=self.now:return 'SK_A_WARD',ward
+        if a.basic_at<=self.now:return a.id+'_BASIC','boss'
+        return None
+
+    def forecast_incoming_at(self,actor,action,time,redirect=False):
+        raw=Fraction(self.boss['power']*action['coefficient_bp'],10000)
+        if self.weaken_expiry>time:raw*=Fraction(8800,10000)
+        reduction=actor.stats.get('heavy_reduction_bp',0) if action.get('heavy') else 0
+        if redirect:reduction+=1500
+        return self.rules.direct_incoming(floor(raw),actor.stats['defense'],self.boss['level'],False,reduction)
+
+    def danger_for(self,aid,without_cover=False):
+        if not self.profile.temporal_forecast:
+            return super().danger_for(aid,without_cover)
+        a=self.actors[aid];hp=a.hp;loss=0;single=0
+        relevant=[x for x in self.public_forecast(without_cover) if x[1]==aid]
+        if not relevant:return False,0,hp
+        shields=[{'amount':s.amount,'expiry':s.expiry} for s in a.shields]
+        pending=[]
+        for actor in self.actors.values():
+            c=actor.casting
+            if actor.hp>0 and c and c['target']==aid and c['skill'] in ('SK_A_HEAL','SK_A_WARD'):
+                pending.append((c['finish'],ORDER.index(actor.id),c['skill'],actor))
+        pending.sort(key=lambda p:(p[0],p[1]))
+        for time,target,action,redirect in relevant:
+            while pending and pending[0][0]<time:
+                when,_,skill,source=pending.pop(0)
+                shields=[s for s in shields if s['expiry']>when and s['amount']>0]
+                if hp<=0:break # A normal heal cannot resurrect.
+                if skill=='SK_A_HEAL':hp=min(a.stats['hp'],hp+self.heal_nominal(source))
+                else:
+                    nominal=self.ward_nominal(source)*(10000+a.stats.get('barrier_received_bp',0))//10000
+                    gain=self.rules.barrier_add(sum(s['amount'] for s in shields),a.stats['hp'],nominal)
+                    if gain:shields.append({'amount':gain,'expiry':when+6000})
+            shields=[s for s in shields if s['expiry']>time and s['amount']>0]
+            inc=self.forecast_incoming_at(a,action,time,redirect)
+            for shield in sorted(shields,key=lambda s:s['expiry']):
+                take=min(inc,shield['amount']);inc-=take;shield['amount']-=take
+            hp-=inc;loss+=inc;single=max(single,inc)
+        danger=single*10000>=a.stats['hp']*2000 or hp*10000<=a.stats['hp']*3500
+        return danger,loss,hp
